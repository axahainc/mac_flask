# --- Core ---
ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
DATABASE_URL=postgresql://vtu_user:vtu_pass@localhost:5432/vtu_db
REDIS_URL=redis://localhost:6379/0

# --- Payment gateway (wallet funding) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# --- Upstream top-up providers (order = failover priority) ---
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=xxxxx
VTPASS_SECRET_KEY=xxxxx
VTPASS_PUBLIC_KEY=xxxxx

RELOADLY_BASE_URL=https://topups-sandbox.reloadly.com
RELOADLY_CLIENT_ID=xxxxx
RELOADLY_CLIENT_SECRET=xxxxx

# --- Webhook security ---
WEBHOOK_SIGNING_SECRET=change-me
